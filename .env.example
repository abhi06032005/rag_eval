# RAGScaleBench Environment Configuration

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false

# LLM Generation Backends
# Choices: mock | ollama | vllm | api
GENERATOR_BACKEND=mock
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_GENERATOR_MODEL=llama3.2:3b

# vLLM / Generic OpenAI API compatibility
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=token-vllm-local
API_GENERATOR_BASE_URL=https://api.openai.com/v1
API_GENERATOR_API_KEY=

# Embeddings
EMBEDDING_DEVICE=cpu
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Permission-Controlled Sources
# UN requires request; leave blank to enforce safe refusal
UN_PERMISSION_REFERENCE=

# Service Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=1048576
MAX_RETRIEVED_CHUNKS=50
